# EQIDIS AI web for several people. Replace eqidis.tuempresa.com with the real domain.
[Unit]
Description=EQIDIS AI (web, multiusuario)
After=network-online.target
Wants=network-online.target

[Service]
User=eqidis
Group=eqidis
WorkingDirectory=/srv/eqidis/app
Environment=NODE_ENV=production
Environment=DSH_HOME=/srv/eqidis/datos
Environment=EQIDIS_CUENTAS=1
Environment=EQIDIS_CARPETAS=/srv/eqidis/usuarios
Environment=EQIDIS_COOKIES_SEGURAS=1
ExecStart=/usr/bin/pnpm dsh web --no-open --port 3080 --public-url https://eqidis.tuempresa.com/ --trusted-host eqidis.tuempresa.com
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
