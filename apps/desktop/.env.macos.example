# FiscalCFDI AI macOS packaging settings. Copy to .env.macos and run
#   pnpm --filter @deepseek-ai/dsh-desktop package:mac:arm64:unsigned
# FiscalCFDI AI keeps its data in ~/.fiscalcfdi-ai (FISCALCFDI_AI_HOME overrides it).
DSH_DESKTOP_APP_ID=mx.fiscalcfdi.ai
DSH_DESKTOP_MACOS_PACK_CONCURRENCY=4

# Optional: a releases repository for internal updates (owner/repository).
# DSH_DESKTOP_INTERNAL_UPDATE_REPOSITORY=CarlosVP120/fiscalcfdi-ai-releases

# Optional: a local self-signed identity, so macOS keeps permissions across updates.
# DSH_DESKTOP_MACOS_LOCAL_SIGNING_IDENTITY=FiscalCFDI AI Self-Signed
# DSH_DESKTOP_MACOS_LOCAL_SIGNING_KEYCHAIN=.desktop-signing/fiscalcfdi.keychain-db

# Signed releases (Developer ID) fill these instead of the local identity.
DSH_DESKTOP_MACOS_SIGNING_IDENTITY=
DSH_DESKTOP_MACOS_TEAM_ID=
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
