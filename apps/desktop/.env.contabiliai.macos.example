# ContabiliAI macOS packaging settings. Copy to .env.contabiliai.macos and run
#   DSH_DESKTOP_PRODUCT=contabiliai pnpm --filter @deepseek-ai/dsh-desktop package:mac:arm64:unsigned
# ContabiliAI keeps its own bundle identifier, so it installs beside EQIDIS AI
# and never shares its data (~/.contabiliai), keychain items or update feed.
DSH_DESKTOP_APP_ID=mx.contabiliai.app
DSH_DESKTOP_MACOS_PACK_CONCURRENCY=4

# Optional: a releases repository of its own for internal updates (owner/repository).
# DSH_DESKTOP_INTERNAL_UPDATE_REPOSITORY=CarlosVP120/contabiliai-releases

# Optional: a local self-signed identity, so macOS keeps permissions across updates.
# DSH_DESKTOP_MACOS_LOCAL_SIGNING_IDENTITY=ContabiliAI Self-Signed
# DSH_DESKTOP_MACOS_LOCAL_SIGNING_KEYCHAIN=.desktop-signing/contabiliai.keychain-db
